{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink",          "color": "#0a2540", "name": "Legacy Ink (Primary Navy)" },
        { "slug": "ink-2",        "color": "#142e4f", "name": "Legacy Ink 2 (Hero Gradient)" },
        { "slug": "ink-3",        "color": "#1d3a5f", "name": "Legacy Ink 3 (Dark Surface)" },
        { "slug": "ink-deep",     "color": "#050f1c", "name": "Legacy Ink Deep (Footer)" },
        { "slug": "gold",         "color": "#c9a352", "name": "Heritage Gold (Accent)" },
        { "slug": "gold-soft",    "color": "#e6cf91", "name": "Heritage Gold Soft (Hover)" },
        { "slug": "burgundy",     "color": "#6e2229", "name": "Legacy Burgundy (Secondary)" },
        { "slug": "burgundy-soft","color": "#8e3640", "name": "Legacy Burgundy Soft" },
        { "slug": "cream",        "color": "#f8f3eb", "name": "Cream (Alt Background)" },
        { "slug": "cream-2",      "color": "#efe8db", "name": "Cream 2 (Equity Strip)" },
        { "slug": "paper",        "color": "#ffffff", "name": "Paper (Surface White)" },
        { "slug": "char",         "color": "#161616", "name": "Charcoal (Body Text)" },
        { "slug": "slate",        "color": "#5a6373", "name": "Slate (Muted Text)" },
        { "slug": "line",         "color": "#dbe1ea", "name": "Line (Hairline Border)" }
      ],
      "gradients": [
        {
          "slug": "hero-ink",
          "name": "Hero Ink Gradient",
          "gradient": "linear-gradient(180deg, #0a2540 0%, #142e4f 100%)"
        },
        {
          "slug": "compass-glow",
          "name": "Compass Glow (Gold + Burgundy radial)",
          "gradient": "radial-gradient(circle at 20% 20%, rgba(201,163,82,0.18) 0%, transparent 40%), radial-gradient(circle at 85% 80%, rgba(110,34,41,0.22) 0%, transparent 45%)"
        },
        {
          "slug": "equity-card",
          "name": "Equity Card",
          "gradient": "linear-gradient(135deg, #0a2540 0%, #1d3a5f 100%)"
        },
        {
          "slug": "burgundy-warm",
          "name": "Burgundy Warm",
          "gradient": "linear-gradient(135deg, #6e2229, #3d1216)"
        },
        {
          "slug": "gold-warm",
          "name": "Gold Warm",
          "gradient": "linear-gradient(135deg, #b08434, #6e5215)"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": false,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "slug": "fraunces",
          "name": "Fraunces",
          "fontFamily": "Fraunces, 'Times New Roman', Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/fraunces/v28/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk.woff2"]
            },
            {
              "fontFamily": "Fraunces",
              "fontWeight": "400 700",
              "fontStyle": "italic",
              "src": ["https://fonts.gstatic.com/s/fraunces/v28/6NUh8FyLNQOQZAnv9ZwSvDiIdE9Ea92uemAk.woff2"]
            }
          ]
        },
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/inter/v18/UcC73FwrK3iLTeHuS_nVMrMxCp50ojIw2y4P.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs",     "size": "12px",                                             "name": "XS (Eyebrow)" },
        { "slug": "sm",     "size": "14px",                                             "name": "Small (UI)" },
        { "slug": "base",   "size": "16px",                                             "name": "Body" },
        { "slug": "md",     "size": "17px",                                             "name": "Body Large" },
        { "slug": "lg",     "size": "19px",                                             "name": "Lede" },
        { "slug": "xl",     "size": "clamp(20px, 1.6vw, 24px)",                         "name": "H3" },
        { "slug": "2xl",    "size": "clamp(28px, 3vw, 44px)",                           "name": "H2" },
        { "slug": "3xl",    "size": "clamp(34px, 3.6vw, 52px)",                         "name": "H2 Large" },
        { "slug": "4xl",    "size": "clamp(40px, 5.6vw, 80px)",                         "name": "H1 (Hero)" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        { "slug": "1",  "size": "8px",   "name": "1 (Hairline)" },
        { "slug": "2",  "size": "16px",  "name": "2 (Tight)" },
        { "slug": "3",  "size": "24px",  "name": "3 (Standard)" },
        { "slug": "4",  "size": "32px",  "name": "4 (Comfortable)" },
        { "slug": "5",  "size": "48px",  "name": "5 (Spacious)" },
        { "slug": "6",  "size": "72px",  "name": "6 (Section)" },
        { "slug": "7",  "size": "96px",  "name": "7 (Hero Vertical)" },
        { "slug": "8",  "size": "120px", "name": "8 (Section Block)" },
        { "slug": "9",  "size": "160px", "name": "9 (Editorial)" }
      ]
    },
    "layout": {
      "contentSize": "820px",
      "wideSize": "1240px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "presets": [
        { "slug": "sm", "name": "Small",  "shadow": "0 1px 2px rgba(10,37,64,.06), 0 4px 12px rgba(10,37,64,.04)" },
        { "slug": "md", "name": "Medium", "shadow": "0 8px 28px rgba(10,37,64,.08), 0 2px 6px rgba(10,37,64,.04)" },
        { "slug": "lg", "name": "Large",  "shadow": "0 24px 60px rgba(10,37,64,.16), 0 6px 18px rgba(10,37,64,.08)" },
        { "slug": "gold","name":"Gold Glow","shadow": "0 12px 28px rgba(201,163,82,.32)" }
      ]
    },
    "custom": {
      "client": {
        "name": "Jonathan Sweat & The Legacy Team",
        "brokerage": "Integrity Home Mortgage Corporation",
        "domain": "jonathansweat.com",
        "nmls": "308553",
        "branchNmls": "2644421",
        "licenses": ["VA #MLO-5807VA", "FL #LO110533"],
        "phone": "540.314.8843",
        "officePhone": "540.588.6104",
        "email": "jsweat@ihmcloans.com",
        "address": "2840 Electric Rd SW, Suite 102-A, Roanoke, VA 24018",
        "markets": ["Roanoke Valley, VA", "Lakeland, FL", "Tampa, FL"],
        "applicationUrl": "https://www.ihmcloans.com/jonathan-sweat",
        "coachingUrl": "https://compasssalescoaching.com"
      },
      "brand": {
        "primary": "var(--wp--preset--color--ink)",
        "accent": "var(--wp--preset--color--gold)",
        "secondary": "var(--wp--preset--color--burgundy)",
        "register": "mortgage-legacy",
        "headingFont": "var(--wp--preset--font-family--fraunces)",
        "bodyFont": "var(--wp--preset--font-family--inter)"
      },
      "transitions": {
        "fast": "0.2s ease",
        "base": "0.25s ease",
        "slow": "0.35s ease"
      },
      "radius": {
        "sm": "3px",
        "base": "4px",
        "md": "6px",
        "lg": "12px",
        "pill": "999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--char)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontWeight": "500",
          "lineHeight": "1.1",
          "letterSpacing": "-0.01em"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "500",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "12px",
          "fontWeight": "700",
          "letterSpacing": "0.16em",
          "textTransform": "uppercase"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--gold)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "15px",
          "fontWeight": "600",
          "letterSpacing": "0.01em"
        },
        "spacing": {
          "padding": { "top": "16px", "right": "26px", "bottom": "16px", "left": "26px" }
        },
        "border": { "radius": "4px" },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--gold-soft)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "12.5px",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase",
          "fontWeight": "600"
        },
        "color": { "text": "var(--wp--preset--color--slate)" }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)"
        }
      },
      "core/paragraph": {
        "typography": {
          "lineHeight": "1.65"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontStyle": "italic",
          "fontSize": "var(--wp--preset--font-size--lg)"
        },
        "border": {
          "color": "var(--wp--preset--color--gold)",
          "width": "0 0 0 2px",
          "style": "solid"
        },
        "spacing": {
          "padding": { "top": "8px", "right": "0", "bottom": "8px", "left": "28px" }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "30px",
          "fontWeight": "400",
          "lineHeight": "1.25"
        },
        "color": { "text": "var(--wp--preset--color--ink)" },
        "border": {
          "color": "var(--wp--preset--color--line)",
          "width": "1px 0",
          "style": "solid"
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--8)",
            "bottom": "var(--wp--preset--spacing--8)"
          }
        }
      },
      "core/cover": {
        "color": {
          "text": "#ffffff"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--line)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header",   "title": "Header",   "area": "header" },
    { "name": "footer",   "title": "Footer",   "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (No Title)", "postTypes": ["page"] },
    { "name": "page-full",     "title": "Page (Full Width)", "postTypes": ["page"] }
  ]
}
